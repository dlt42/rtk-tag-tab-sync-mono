{
  "name": "rtk-tag-tab-sync-mono",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently 'pnpm run dev:client' 'pnpm run dev:server'",
    "dev:client": "pnpm --filter rtk-tag-tab-sync-example-client dev",
    "dev:server": "pnpm --filter rtk-tag-tab-sync-example-server dev",
    "build-verbose": "tsc --build --verbose",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "pnpm --filter rtk-tag-tab-sync test",
    "clean": "pnpm -r clean",
    "ci": "pnpm run check-format && pnpm run lint && pnpm run build-verbose && pnpm run test && pnpm run check-exports",
    "check-exports": "pnpm --filter rtk-tag-tab-sync check-exports",
    "check-format": "prettier --check .",
    "check-dead-code": "ts-prune",
    "check-updates": "npx npm-check-updates",
    "check-links": "npm ls -g --depth=0 --link=true",
    "full": "pnpm run clean && pnpm run ci",
    "local-release": "changeset version && changeset publish",
    "prepublishOnly": "pnpm run ci"
  },
  "dependencies": {
    "globals": "^17.13.0",
    "react": "^18.3.1",
    "rtk-tag-tab-sync": "workspace:^",
    "ts-prune": "^0.10.3",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/compat": "^2.1.1",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "concurrently": "10.0.5",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "process": "^0.11.10",
    "ts-node": "^10.9.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "@eslint/js": "^10.0.1",
    "@eslint/eslintrc": "^3.3.7",
    "typescript-eslint": "^8.71.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.6"
  }
}
