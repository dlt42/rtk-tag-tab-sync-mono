{
  "name": "rtk-tag-tab-sync",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Utilities supporting cross tab tag invalidation for Redux Tooklit",
  "author": "Daniel Taylor <dev.dlt.42@gmail.com>",
  "keywords": [
    "rtk",
    "tag",
    "invalidation",
    "tab"
  ],
  "scripts": {
    "test": "vitest run",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "check-exports-debug": "attw --pack . --ignore-rules=cjs-resolves-to-esm -f json",
    "clean": "rm -r dist && rm -r node_modules & rm tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "msw": "^3.0.1",
    "node-fetch": "^3.3.2",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3",
    "@reduxjs/toolkit": "^2.13.0",
    "react-redux": "^9.3.0"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-new-window": "^1.0.1",
    "react-redux": "^9.1.2"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DLT-42/rtk-tag-tab-sync-mono.git"
  }
}
